# Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_MEDIA_RESOLUTION=
GEMINI_BATCH_SIZE=

# Thời gian tự động làm mới / re-fetch hình ảnh camera (tính theo giây)
NEXT_PUBLIC_CAMERA_REFRESH_INTERVAL=

# Chu kỳ tự động kiểm tra thời tiết Open-Meteo & phân tích ngập lụt AI (tính theo giây)
NEXT_PUBLIC_FLOOD_INTERVAL=

# Thời gian lưu giữ kết quả phân tích AI trước khi quét lại (TTL 5-10 phút, mặc định 8 phút)
GEMINI_FLOOD_TTL_MINUTES=

# Bán kính gom cụm & lan tỏa Spatial Cache cho camera lân cận (km)
GEMINI_SPATIAL_CACHE_RADIUS_KM=

# Bán kính gom cụm đại diện lấy mẫu thời tiết (km)
NEXT_PUBLIC_WEATHER_SAMPLE_RADIUS_KM=


NEXT_PUBLIC_GA_ID=

# Supabase Database Cache tập trung (Ghi đè UPSERT < 1MB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# (Tùy chọn) Google Maps API Key dùng cho Geocoding / Directions
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
